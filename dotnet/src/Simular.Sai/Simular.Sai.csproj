<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Simular.Sai</RootNamespace>
    <PackageId>Simular.Sai</PackageId>
    <Version>0.1.0</Version>
    <Authors>Simular</Authors>
    <Company>Simular, Inc.</Company>
    <Description>.NET SDK for the Sai API: delegate desktop work to Sai, or drive a cloud computer directly.</Description>
    <PackageTags>sai;simular;agent;computer-use;automation</PackageTags>
    <PackageProjectUrl>https://platform.simular.ai/documentation/sdks/dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/simular-ai/sai-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Records and options document themselves through their names; the public API has summaries where they add something. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
