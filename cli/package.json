    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.3",
    "typescript": "^5.0.0",
    "vitest": "^4.1.3"
  }
}
