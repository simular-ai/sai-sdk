{
  "name": "@simular-ai/sai-cli",
  "version": "0.2.0",
  "description": "Sai CLI \u2014 command-line interface for Simular.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simular-ai/sai-sdk.git",
    "directory": "cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "sai": "./dist/cli.cjs"
  },
  "files": [
    "dist/cli.cjs",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node build.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "gate:src": "true",
    "gate:test": "true"
  },
  "dependencies": {
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "esbuild": "0.28.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
