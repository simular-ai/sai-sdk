{
  "name": "@simular-ai/sai-mcp",
  "version": "0.4.0",
  "description": "Sai MCP server \u2014 drive your Sai computer-use agent from Claude Code, Codex, or Cursor.",
  "homepage": "https://platform.simular.ai",
  "keywords": [
    "mcp",
    "mcp-server",
    "computer-use",
    "browser-automation",
    "desktop-automation",
    "windows",
    "ai-agent",
    "claude-code",
    "codex",
    "cursor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simular-ai/sai-sdk.git",
    "directory": "mcp"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "sai-mcp": "./dist/server.js"
  },
  "files": [
    "dist/server.js",
    "SKILL.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "node build.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "gate:src": "true",
    "gate:test": "true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "esbuild": "0.28.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
