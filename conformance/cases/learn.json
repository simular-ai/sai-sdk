{
  "cases": [
    {
      "id": "learn.create.convert",
      "doc": "create(turns) converts recorded turns; turn ids or Turns; the result's parameters, validation and ok.",
      "steps": [
        { "call": "sessions.resume", "args": { "session_id": "cs_1" }, "save": "session" },
        { "call": "session.send", "args": { "message": "x" }, "save": "turn2" },
        {
          "call": "learn.create",
          "args": {
            "turns": ["turn_1", { "$ref": "turn2" }],
            "task_template": "Open {{site}} and read the top story",
            "idempotency_key": "k1"
          },
          "save": "learned",
          "expect": {
            "result": {
              "id": "learn_1",
              "mode": "convert",
              "status": "succeeded",
              "ok": true,
              "title": "Read the top story",
              "template": "Open {{site}} and read the top story",
              "parameters": [
                {
                  "name": "site",
                  "default_value": "https://news.ycombinator.com",
                  "description": null
                },
                { "name": "n", "default_value": "1", "description": "How many" }
              ],
              "code": "async function main(params = { site: \"x\", n: \"1\" }) { return params.site }",
              "validation": { "errors": [], "warnings": ["w"] },
              "source_turns": ["turn_1"],
              "usage": { "input_tokens": 100, "output_tokens": 20 },
              "replayed": false,
              "error": null,
              "iterations": [],
              "test_result": null,
              "version": null
            }
          }
        },
        {
          "call": "learn.get",
          "args": { "learn_id": "learn_1" },
          "expect": { "result": { "id": "learn_1", "ok": true } }
        }
      ],
      "exchanges": [
        {
          "request": { "method": "POST", "path": "/v1/agents/message" },
          "response": { "status": 202, "json": { "sessionId": "cs_1", "turnId": "turn_2" } }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/agents/learn",
            "json": {
              "turns": ["turn_1", "turn_2"],
              "taskTemplate": "Open {{site}} and read the top story",
              "idempotency_key": "k1"
            }
          },
          "response": {
            "json": {
              "learnId": "learn_1",
              "mode": "convert",
              "status": "succeeded",
              "title": "Read the top story",
              "template": "Open {{site}} and read the top story",
              "parameters": [
                { "name": "site", "defaultValue": "https://news.ycombinator.com" },
                { "name": "n", "defaultValue": "1", "description": "How many" }
              ],
              "code": "async function main(params = { site: \"x\", n: \"1\" }) { return params.site }",
              "validation": { "errors": [], "warnings": ["w"] },
              "sourceTurns": ["turn_1"],
              "usage": { "inputTokens": 100, "outputTokens": 20 }
            }
          }
        },
        {
          "request": { "method": "GET", "path": "/v1/agents/learn/learn_1" },
          "response": {
            "json": { "learnId": "learn_1", "mode": "convert", "status": "succeeded", "code": "x" }
          }
        }
      ]
    },
    {
      "id": "learn.create.repair",
      "doc": "A repair sends initial_code with guidance and history, or with evaluations whose run results are trimmed to the last 30 log lines and the error's kind and message.",
      "steps": [
        {
          "call": "learn.create",
          "args": {
            "turns": [],
            "initial_code": "code",
            "guidance": "Return the URL too",
            "history": "Version 1: run 1 failed: no URL"
          },
          "expect": { "result": { "mode": "heal", "status": "succeeded" } }
        },
        { "call": "control.open", "args": { "machine": "m_1" }, "save": "lease" },
        {
          "call": "lease.exec",
          "args": { "code": "await main()" },
          "save": "run",
          "expect": { "result": { "ok": false, "logs": { "$len": 40 } } }
        },
        {
          "call": "learn.create",
          "args": {
            "turns": [],
            "initial_code": "code",
            "evaluations": [
              {
                "inputs": { "site": "a" },
                "result": { "$ref": "run" },
                "judgement": "judgement_1",
                "passed": false
              },
              { "inputs": { "site": "b" }, "passed": true, "note": "fine" }
            ]
          },
          "expect": { "result": { "mode": "heal" } }
        },
        {
          "call": "learn.create",
          "args": { "turns": ["turn_1"], "runs_without_reset": true },
          "expect": { "result": { "mode": "convert" } }
        }
      ],
